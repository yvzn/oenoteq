@baseUrl = http://localhost:8080

### Health check
GET {{baseUrl}}/health

### Create Appellation
POST {{baseUrl}}/appellations
Content-Type: application/json

{
  "name": "Saint Nicolas de Bourgueil"
}

### List Appellations
GET {{baseUrl}}/appellations

### Rename Appellation
PUT {{baseUrl}}/appellations/1
Content-Type: application/json

{
  "name": "Saint Nicolas de Bourgueil (revised)"
}

### Delete Appellation (rejected with appellation_in_use if still referenced by a Wine or Meal Pairing)
DELETE {{baseUrl}}/appellations/1



### Create Producer
POST {{baseUrl}}/producers
Content-Type: application/json

{
  "name": "Domaine du Closel"
}

### List Producers
GET {{baseUrl}}/producers

### Rename Producer
PUT {{baseUrl}}/producers/1
Content-Type: application/json

{
  "name": "Domaine du Closel (revised)"
}

### Delete Producer (rejected with producer_in_use if still referenced by a Wine)
DELETE {{baseUrl}}/producers/1



### Create Meal
POST {{baseUrl}}/meals
Content-Type: application/json

{
  "name": "Boeuf bourguignon"
}

### List Meals
GET {{baseUrl}}/meals

### Rename Meal
PUT {{baseUrl}}/meals/1
Content-Type: application/json

{
  "name": "Boeuf bourguignon (revised)"
}

### Delete Meal (rejected with meal_in_use if still referenced by a Meal Pairing)
DELETE {{baseUrl}}/meals/1



### Create Wine
POST {{baseUrl}}/wines
Content-Type: application/json

{
  "millesime": 2018,
  "appellation_id": 1,
  "producer_id": 1,
  "color": "rouge",
  "garde_debut": 2020,
  "garde_fin": 2028,
  "quantity": 6
}

### List Wines
GET {{baseUrl}}/wines

### Get Wine detail (response includes suggested_meals derived from appellation+color, and consumption_history ordered by date)
GET {{baseUrl}}/wines/1

### Edit Wine
PUT {{baseUrl}}/wines/1
Content-Type: application/json

{
  "millesime": 2018,
  "appellation_id": 1,
  "producer_id": 1,
  "color": "rouge",
  "garde_debut": 2020,
  "garde_fin": 2028,
  "quantity": 5
}



### Record a Consumption for a Wine (decrements quantity, rejected if quantity is 0)
POST {{baseUrl}}/wines/1/consumptions
Content-Type: application/json

{
  "date": "2026-01-15",
  "rating": 4,
  "notes": "Great with duck"
}

### Edit a Consumption (date/rating/notes only, wine_id is not editable)
PUT {{baseUrl}}/consumptions/1
Content-Type: application/json

{
  "date": "2026-01-16",
  "rating": 5,
  "notes": "Great with duck, revised"
}

### Delete a Consumption (restores the referenced Wine's quantity by one)
DELETE {{baseUrl}}/consumptions/1



### Associate Meal with (Appellation, Color)
POST {{baseUrl}}/meal-pairings
Content-Type: application/json

{
  "appellation_id": 1,
  "color": "rouge",
  "meal_id": 1
}

### List Meals for (Appellation, Color)
GET {{baseUrl}}/meal-pairings?appellation_id=1&color=rouge

### Remove Meal from (Appellation, Color)
DELETE {{baseUrl}}/meal-pairings
Content-Type: application/json

{
  "appellation_id": 1,
  "color": "rouge",
  "meal_id": 1
}



### Search: filters (meal, appellation, color, ready_now) combine with AND; quantity=0 excluded by default; each result carries garde_status (too_young/ready/past_peak)
GET {{baseUrl}}/search?appellation_id=1&color=rouge&ready_now=true

### Search: by meal alone (matches Wines whose appellation+color is paired with the meal)
GET {{baseUrl}}/search?meal_id=1

### Search: ready_now alone (everything currently in its garde window)
GET {{baseUrl}}/search?ready_now=true

### Search: no filters (everything in stock, flagged with garde_status)
GET {{baseUrl}}/search

